# Audivo Backend — environment variables


# ── Server ────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ── Database (MySQL, via Sequelize) ─────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=audivo
DB_USER=root
DB_PASSWORD=

# ── Auth ─────────────────────────────────────────────────────────────────
# JWT_SECRET must be a long, random string in any real environment — never
# reuse this across projects. JWT_EXPIRES_IN accepts values like '15m', '7d'.
JWT_SECRET=
JWT_EXPIRES_IN=1d

# How long the httpOnly session cookie stays valid, in milliseconds.
# 604800000 = 7 days.
COOKIE_MAX_AGE_MS=604800000

# How long an email-verification link stays valid, in hours.
EMAIL_TOKEN_EXPIRES_HOURS=24

# Blocks login for accounts that haven't verified their email yet.
# 'true' or 'false'.
REQUIRE_VERIFIED_EMAIL=false

# ── Redis / BullMQ (job queues — e.g. AI lyrics transcription) ─────────────
# On Windows this points at Memurai. Defaults below match Memurai's defaults,
# so these can usually be left as-is for local dev.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ── SMTP (email delivery — Mailtrap in dev) ─────────────────────────────────
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# Optional — the "from" address on outgoing mail. Falls back to SMTP_USER
# if left blank.
SMTP_FROM=

# Where contact-form messages are addressed to. Falls back to SMTP_FROM, then
# SMTP_USER, if left blank.
SUPPORT_EMAIL=

# ── URLs ─────────────────────────────────────────────────────────────────
# This backend's own public URL — used to build links in emails and to serve
# static cover/avatar images.
API_BASE_URL=http://localhost:5000

# The frontend's public URL — used in email links that should land on the
# React app rather than the API.
FRONTEND_BASE_URL=http://localhost:5173

# The single origin allowed to make credentialed requests to this API (CORS).
# Must match FRONTEND_BASE_URL exactly, protocol included, no trailing slash.
FRONTEND_ORIGIN=http://localhost:5173

# ── Transcription microservice (Python FastAPI: Demucs + faster-whisper) ───
TRANSCRIPTION_SERVICE_URL=http://localhost:8001
